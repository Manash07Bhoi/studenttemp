# StudentTemp — Environment Variables
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file — it is in .gitignore.

# ---------- Database ----------
# Sandbox/dev: SQLite file
# Production: PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/studenttemp

# ---------- VAPID keys for Web Push notifications ----------
# Generate fresh keys: npx web-push generate-vapid-keys
# NEVER reuse sandbox keys in production — they were committed to git history.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ---------- SMTP relay (outbound email) ----------
# Internal loopback — the mail-service SMTP server on port 2525.
# This is an internal connection (loopback), so plain TCP is acceptable.
SMTP_RELAY_HOST=localhost
SMTP_RELAY_PORT=2525

# ---------- Trusted proxy ----------
# The immediate peer of the Next.js process. In production, this is Caddy
# which connects from loopback. The middleware in src/proxy.ts trusts
# X-Forwarded-Proto from this peer.
TRUSTED_PROXY_HOSTS=127.0.0.1,::1,localhost

# ---------- Public base URL ----------
# The canonical HTTPS origin of the deployment. Used by the mail-service
# to whitelist CORS origins on the Socket.IO gateway.
# Dev: https://localhost:81
# Prod: https://your-domain.com
PUBLIC_BASE_URL=https://localhost:81

# ---------- TOTP encryption key (2FA) ----------
# Used to encrypt TOTP secrets stored on the Account model.
# Generate with: openssl rand -hex 32
TOTP_ENCRYPTION_KEY=

# ---------- Relay provider (outbound email — Account Mode) ----------
# Sign up at https://resend.com or https://brevo.com
# Used for: Account Mode send-mail, vacation auto-reply, filter forwarding
RESEND_API_KEY=
# OR: BREVO_API_KEY=

# ---------- Sentry (error tracking) ----------
# Sign up at https://sentry.io (free tier)
SENTRY_DSN=

# ---------- Environment ----------
NODE_ENV=development
