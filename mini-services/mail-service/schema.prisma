// StudentTemp — privacy-first temporary email platform
// Prisma schema (SQLite) — mirrors the production Postgres schema in DATABASE.md
// All fields are real (no fake/placeholder columns). Auth results come from real
// SMTP connection data via the mail-service.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:/home/z/my-project/db/custom.db"
}

model Session {
  id              String   @id @default(cuid())
  // Hashed recovery token (SHA-256). Raw token shown to user once, never stored.
  tokenHash       String   @unique
  createdAt       DateTime @default(now())
  lastSeenAt      DateTime @default(now())
  expiresAt       DateTime // rolling TTL
  maxInboxes      Int      @default(5)
  locale          String   @default("en")
  inboxes         Inbox[]
  subscriptions   NotificationSubscription[]
  auditLogs       AuditLog[]

  @@index([expiresAt])
}

model Domain {
  id              String   @id @default(cuid())
  domain          String   @unique
  pack            String   @default("standard") // standard | indian_student | international | privacy | quick
  country         String   @default("global") // global | india | us | uk | etc
  category        String   @default("general") // general | student | developer | privacy | testing
  mxEnabled       Boolean  @default(true)
  active          Boolean  @default(true) // kill-switch
  reputationScore Int      @default(100)
  createdAt       DateTime @default(now())
  inboxes         Inbox[]
}

model Inbox {
  id              String   @id @default(cuid())
  publicId        String   @unique @default(cuid()) // opaque external identifier
  sessionId       String?
  session         Session? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  email           String   @unique // denormalized localPart@domain for fast SMTP recipient lookup
  localPart       String
  domainId        String
  domain          Domain  @relation(fields: [domainId], references: [id])
  isCustomAlias   Boolean  @default(false)
  status          String   @default("active") // active | expiring | expired | deleted
  category        String   @default("general")
  burnOnRead      Boolean  @default(false)
  createdAt       DateTime @default(now())
  expiresAt       DateTime
  lastActivityAt  DateTime @default(now())
  messageCount    Int      @default(0)
  maxMessages     Int      @default(100)
  messages        Message[]

  @@unique([localPart, domainId, status])
  @@index([sessionId])
  @@index([expiresAt])
  @@index([status])
}

model CustomAlias {
  // Reservation/cooldown ledger — separate from inbox lifecycle for anti-squatting
  id                    String   @id @default(cuid())
  localPart             String
  domainId              String
  lastUsedBySessionHash String?  // hashed for cooldown enforcement only
  cooldownUntil         DateTime?
  createdAt             DateTime @default(now())

  @@unique([localPart, domainId])
  @@index([cooldownUntil])
}

model Message {
  id              String   @id @default(cuid())
  publicId        String   @unique @default(cuid())
  inboxId         String
  inbox           Inbox    @relation(fields: [inboxId], references: [id], onDelete: Cascade)
  smtpMessageId   String?  // from Message-ID header
  senderAddress   String
  senderDisplayName String?
  senderIp        String?  // real connecting IP from SMTP session
  subject         String
  previewText     String
  bodyText        String
  bodyHtml        String   // sanitized HTML stored inline (SQLite; in prod would be R2 key)
  receivedAt      DateTime @default(now())
  sizeBytes       Int      @default(0)
  hasHtml         Boolean  @default(false)
  hasText         Boolean  @default(false)
  hasAttachment   Boolean  @default(false)
  // Real authentication results computed by mailauth from actual SMTP connection + DNS
  authSpf         String   @default("none") // pass | fail | neutral | none | error | softfail
  authDkim        String   @default("none")
  authDmarc       String   @default("none")
  authDetails     String   @default("{}") // JSON: full verification results
  isRead          Boolean  @default(false)
  isStarred       Boolean  @default(false)
  isReported      Boolean  @default(false)
  scanStatus      String   @default("clean") // pending | clean | quarantined | failed
  attachments     Attachment[]
  abuseReports     AbuseReport[]
  externalResourcesBlocked Int @default(0)

  @@index([inboxId])
  @@index([receivedAt])
}

model Attachment {
  id           String   @id @default(cuid())
  messageId    String
  message      Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  filename     String   // sanitized
  originalFilename String? // preserved separately
  mimeType     String   // server-verified via magic bytes
  sizeBytes    Int
  storageKey   String   // local file path in dev; R2 key in prod
  sha256       String
  scanStatus   String   @default("pending") // pending | clean | quarantined | failed
  createdAt    DateTime @default(now())

  @@index([messageId])
  @@index([sha256])
}

model AbuseReport {
  id          String   @id @default(cuid())
  messageId   String
  message     Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reason      String
  category    String   @default("spam") // spam | phishing | abuse | other
  createdAt   DateTime @default(now())
}

model RateLimitBucket {
  // In-memory backup for audit; primary is in-memory token bucket.
  id          String   @id @default(cuid())
  key         String   @unique // ip:hash:endpoint or session:id:endpoint
  windowStart DateTime @default(now())
  count       Int      @default(0)
  limit       Int
}

model NotificationSubscription {
  id          String   @id @default(cuid())
  sessionId   String
  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  endpoint    String
  keys        String   // JSON: p256dh, auth
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  @@index([sessionId])
}

model AuditLog {
  id          String   @id @default(cuid())
  sessionId   String?
  session     Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  action      String
  targetType  String?
  targetId    String?
  metadata    String   @default("{}") // JSON
  ipHash      String?
  createdAt   DateTime @default(now())

  @@index([sessionId])
  @@index([createdAt])
}
