# ---------- Database ----------
DATABASE_URL=file:/home/z/my-project/db/custom.db

# ---------- Public base URL ----------
# The canonical HTTPS origin of the deployment. Used by the mail-service
# to whitelist CORS origins on the Socket.IO gateway, and by the Next.js
# app for absolute URLs (OG metadata, OAuth callbacks, etc.).
#
# Local dev (Caddy on :81 with `tls internal`):
PUBLIC_BASE_URL=https://localhost:81
# Production example:
# PUBLIC_BASE_URL=https://studenttemp.example.com

# ---------- VAPID keys for Web Push notifications ----------
# Generated via `npx web-push generate-vapid-keys`. These are real keys
# used to deliver push notifications to subscribed browsers over HTTPS.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BLa1Bz4MYgNUOkMpsbSKVD0ctcZ8OFSppWC4Gepr7cvwSeKQIRtmOB-BUDC5kBp4fVgHMEqPXKVSDiCdZMV5p1o
***REMOVED***

# ---------- SMTP relay (outbound email) ----------
# Internal host — this is the local SMTP server on port 2525.
# This is an internal connection (loopback), so plain TCP is acceptable
# and does not need TLS. See HTTPS-AUDIT.md §6 for the rationale.
SMTP_RELAY_HOST=localhost
SMTP_RELAY_PORT=2525

# ---------- Trusted proxy ----------
# Set to the immediate peer of the Next.js process. In this deployment that
# is Caddy, which connects from loopback. The middleware in src/middleware.ts
# trusts X-Forwarded-Proto from this peer.
TRUSTED_PROXY_HOSTS=127.0.0.1,::1,localhost

# ---------- Cookie security ----------
# In production, all session cookies are issued with `Secure`. In dev, the
# Secure flag is only set when X-Forwarded-Proto=https from a trusted proxy.
NODE_ENV=development
