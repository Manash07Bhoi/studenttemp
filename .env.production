# ============================================================
# StudentTemp — PRODUCTION Environment Variables
# ============================================================
# This file contains ALL the environment variables needed to run
# StudentTemp in production (Render, Railway, Fly.io, etc.).
#
# HOW TO USE:
# 1. Copy these values into your hosting platform's dashboard
#    (Render: Settings → Environment Variables)
# 2. Replace <PLACEHOLDER> values with your real credentials
# 3. NEVER commit this file to git — it contains secrets
# ============================================================

# ---------- Database ----------
# On Render: Create a PostgreSQL database, copy the "Internal Database URL"
# It looks like: postgresql://user:password@host:5432/studenttemp
DATABASE_URL=<RENDER_POSTGRES_INTERNAL_URL>

# ---------- VAPID Keys (for Web Push notifications) ----------
# These are FRESH keys generated on 2026-08-26.
# Do NOT reuse the old sandbox keys — they were leaked in git history.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BAM5z5-mzFBsOX1gUppiivXRS0PqvobSbCbdvSRmYw3JbEy1_vV0zyNlryHOY1-CmaKpsOVTkwNQ9nyFpKUZXJ0
VAPID_PRIVATE_KEY=VqCsw13sjP6U8At4VLVnvdaWHBHj1fOld07Szz2oIeI

# ---------- Site Access Password Gate ----------
# SHA-256 hash of the password "StudentTemp#8800Roshan"
# This restricts access to only people who know the password.
SITE_ACCESS_PASSWORD_HASH=89ca16241208394e00585912872ecf65b47a8ef3f549355bc6d4a8dc0ca49cca

# ---------- SMTP Relay (for outbound email) ----------
# This connects to the mail-service running on the same server.
# On Render: Use the internal service URL.
SMTP_RELAY_HOST=localhost
SMTP_RELAY_PORT=2525

# ---------- Trusted Proxy ----------
# Render runs behind a proxy — trust loopback
TRUSTED_PROXY_HOSTS=127.0.0.1,::1,localhost

# ---------- Public Base URL ----------
# After deploying on Render, set this to your Render URL.
# Example: https://studenttemp.onrender.com
PUBLIC_BASE_URL=<YOUR_RENDER_URL>

# ---------- Resend (for outbound email via API) ----------
# Sign up at https://resend.com (free, no card)
# Create an API key → paste it here
RESEND_API_KEY=<YOUR_RESEND_API_KEY>

# ---------- TOTP Encryption Key (for 2FA) ----------
# Generate with: openssl rand -hex 32
# This encrypts the TOTP secrets stored in the database.
TOTP_ENCRYPTION_KEY=<GENERATE_WITH_OPENSSL_RAND_HEX_32>

# ---------- Environment ----------
NODE_ENV=production
